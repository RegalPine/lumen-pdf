{
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node", "vscode"],
    "rootDir": "src/extension",
    "strict": true,
    "composite": true,
    "tsBuildInfoFile": ".tmp/tsconfig.extension.tsbuildinfo",
    "noEmit": true
  },
  "include": ["src/extension"],
  "exclude": ["node_modules", "dist", "out", "src/webview"]
}
