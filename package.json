{
  "name": "lumen-pdf",
  "displayName": "Lumen PDF",
  "description": "Lumen PDF — a VS Code Custom Editor for reading and searching PDF documents, with SyncTeX navigation, Dark Paper reading mode, and full-text search.",
  "version": "1.0.1",
  "publisher": "lumen-pdf",
  "private": true,
  "license": "MIT",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "pdf",
    "viewer",
    "reader",
    "latex",
    "synctex",
    "search"
  ],
  "activationEvents": [
    "onCustomEditor:pdfReader.viewer"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "pdfReader.viewer",
        "displayName": "Lumen PDF",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "pdfReader.showLoadDiagnostics",
        "title": "Lumen PDF: 显示加载诊断"
      },
      {
        "command": "pdfReader.toggleColorMode",
        "title": "Lumen PDF: Cycle Reading Color Mode"
      }
    ]
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:ext": "esbuild src/extension/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "build:all": "npm run build && npm run build:ext",
    "watch:webview": "vite build --watch",
    "watch:ext": "esbuild src/extension/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "lint": "tsc -b --noEmit",
    "test": "node --import tsx --test src/webview/utils/pdfSearch.test.ts src/webview/utils/samplePdfBuilder.test.ts src/webview/utils/vscodeBridge.test.ts src/webview/utils/pdfLoadDiagnostics.test.ts src/webview/utils/pdfRenderScheduling.test.ts src/extension/webviewHtml.test.ts src/extension/extension.test.ts",
    "vscode:prepublish": "npm run build:all",
    "package": "npm run lint && npm run build:all && vsce package --allow-missing-repository",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.7.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
